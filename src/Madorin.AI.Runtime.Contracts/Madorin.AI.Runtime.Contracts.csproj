<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Madorin.AI.Runtime.Entities\Madorin.AI.Runtime.Entities.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeContractDependenciesInPackage"
          DependsOnTargets="BuildOnlySettings;ResolveReferences"
          BeforeTargets="_GetBuildOutputFilesWithTfm">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Madorin.AI.Runtime.Entities.dll" />
    </ItemGroup>
  </Target>

</Project>
