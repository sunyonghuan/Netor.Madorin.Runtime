<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Madorin.AI.Runtime.Contracts\Madorin.AI.Runtime.Contracts.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Transport.Abstractions\Madorin.AI.Runtime.Transport.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Transport.NamedPipes\Madorin.AI.Runtime.Transport.NamedPipes.csproj" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="IncludeClientTransportDependenciesInPackage"
          DependsOnTargets="BuildOnlySettings;ResolveReferences"
          BeforeTargets="_GetBuildOutputFilesWithTfm">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)Madorin.AI.Runtime.Transport.Abstractions.dll" />
      <BuildOutputInPackage Include="$(OutputPath)Madorin.AI.Runtime.Transport.NamedPipes.dll" />
    </ItemGroup>
  </Target>

</Project>
