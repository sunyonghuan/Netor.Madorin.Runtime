<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Madorin.AI.Runtime.Contracts\Madorin.AI.Runtime.Contracts.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Orchestration.Abstractions\Madorin.AI.Runtime.Orchestration.Abstractions.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Services\Madorin.AI.Runtime.Services.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Server\Madorin.AI.Runtime.Server.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Client\Madorin.AI.Runtime.Client.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Persistence.Files\Madorin.AI.Runtime.Persistence.Files.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Persistence.Sqlite\Madorin.AI.Runtime.Persistence.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>madorin-cli</AssemblyName>
    <ApplicationIcon>assets\brand.ico</ApplicationIcon>
    <RootNamespace>Madorin.AI.Runtime.Cli</RootNamespace>
    <Version>$(MadorinCliVersion)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>$(AssemblyName)</AssemblyTitle>
    <FileDescription>$(AssemblyName)</FileDescription>
    <Product>$(MadorinProductName)</Product>
    <Company>$(MadorinCompany)</Company>
    <Copyright>$(MadorinCopyright)</Copyright>
    <Description>$(AssemblyName) 轻量级AI 连接CLI 端</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAgentFrameworkRuntimeDirectives>true</UseAgentFrameworkRuntimeDirectives>
    <!-- CLI no longer references Provider OpenAI; keep Skills + Extensions.AI roots only. -->
    <AgentFrameworkRootProfile>WithoutAgentsOpenAI</AgentFrameworkRootProfile>
  </PropertyGroup>

</Project>
