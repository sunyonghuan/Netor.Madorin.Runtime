<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Madorin.AI.Runtime.Contracts\Madorin.AI.Runtime.Contracts.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Orchestration.Abstractions\Madorin.AI.Runtime.Orchestration.Abstractions.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Services\Madorin.AI.Runtime.Services.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Server\Madorin.AI.Runtime.Server.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Client\Madorin.AI.Runtime.Client.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Persistence.Files\Madorin.AI.Runtime.Persistence.Files.csproj" />
    <ProjectReference Include="..\Madorin.AI.Runtime.Persistence.Sqlite\Madorin.AI.Runtime.Persistence.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\logo.png" LogicalName="Madorin.AI.Runtime.Cli.logo.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>madorin-cli</AssemblyName>
    <ApplicationIcon>assets\brand.ico</ApplicationIcon>
    <RootNamespace>Madorin.AI.Runtime.Cli</RootNamespace>
    <Version>$(MadorinCliVersion)</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>$(AssemblyName)</AssemblyTitle>
    <FileDescription>$(AssemblyName)</FileDescription>
    <Product>$(MadorinProductName)</Product>
    <Company>$(MadorinCompany)</Company>
    <Copyright>$(MadorinCopyright)</Copyright>
    <Description>$(AssemblyName) 轻量级AI 连接CLI 端</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <UsePublishAotCross>true</UsePublishAotCross>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAgentFrameworkRuntimeDirectives>true</UseAgentFrameworkRuntimeDirectives>
    <!-- CLI no longer references Provider OpenAI; keep Skills + Extensions.AI roots only. -->
    <AgentFrameworkRootProfile>WithoutAgentsOpenAI</AgentFrameworkRootProfile>
  </PropertyGroup>

  <!-- Runtime 在 CLI 进程目录查找 madorin-provider-*.exe。构建后把各 Worker 输出里尚未存在的文件补进 CLI 目录。 -->
  <Target Name="CopyProviderWorkerDrivers" AfterTargets="Build">
    <ItemGroup>
      <_ProviderWorkerDriver Include="$(MSBuildThisFileDirectory)..\Providers\*.Worker\bin\$(Configuration)\$(TargetFramework)\madorin-provider-*.*" />
      <_ProviderWorkerDependency Include="$(MSBuildThisFileDirectory)..\Providers\*.Worker\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_ProviderWorkerDependency Include="$(MSBuildThisFileDirectory)..\Providers\*.Worker\bin\$(Configuration)\$(TargetFramework)\*.pdb" />
      <_ProviderWorkerFile Include="@(_ProviderWorkerDriver)" />
      <_ProviderWorkerFile Include="@(_ProviderWorkerDependency)"
                           Condition="!Exists('$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProviderWorkerFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_ProviderWorkerFile)' != ''" />
  </Target>

</Project>
