{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "task": { "type": "string", "enum": ["text-to-video", "image-to-video"] },
    "model": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "attachments": { "type": "array", "maxItems": 1 },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": { "type": "integer", "minimum": 2, "maximum": 15 },
        "resolution": { "type": "string", "enum": ["720P", "1080P"] },
        "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"] },
        "negative_prompt": { "type": "string", "maxLength": 500 }
      }
    },
    "provider_parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aliyun": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_extend": { "type": "boolean" },
            "watermark": { "type": "boolean" },
            "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "audio_url": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_dir": { "type": "string", "minLength": 1 },
        "timeout": { "type": "integer", "minimum": 1 },
        "try_run": { "type": "boolean" },
        "verbose": { "type": "boolean" },
        "no_wait": { "type": "boolean" },
        "output_format": { "type": "string", "const": "json" }
      }
    }
  }
}
