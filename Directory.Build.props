<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 网络环境会将 api.nuget.org 重定向到 nuget.azure.cn，NuGet 漏洞审计在该链路上失败并因 TreatWarningsAsErrors 阻断构建；审计与编译无关，统一关闭。 -->
    <NuGetAudit>false</NuGetAudit>
    <Deterministic>true</Deterministic>
    <IsAotCompatible>true</IsAotCompatible>
    <AgentFrameworkRootProfile Condition="'$(AgentFrameworkRootProfile)' == ''">Full</AgentFrameworkRootProfile>
    <MadorinCliVersion>0.1.72</MadorinCliVersion>
    <MadorinProductName>madorin-cli</MadorinProductName>
    <MadorinCompany>©madorin 藏将科技出品</MadorinCompany>
    <MadorinCopyright>Madorin &amp; Streamx</MadorinCopyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/testrun*/**;Artifacts/testrun*/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(UseAgentFrameworkRuntimeDirectives)' == 'true'">
    <RdXmlFile Include="$(MSBuildThisFileDirectory)publish\rd.xml"
               Condition="'$(AgentFrameworkRootProfile)' == 'Full'" />
    <RdXmlFile Include="$(MSBuildThisFileDirectory)publish\rd.no-agents-openai.xml"
               Condition="'$(AgentFrameworkRootProfile)' == 'WithoutAgentsOpenAI'" />
    <RdXmlFile Include="$(MSBuildThisFileDirectory)publish\rd.extensions-only.xml"
               Condition="'$(AgentFrameworkRootProfile)' == 'ExtensionsOnly'" />

    <TrimmerRootAssembly Include="Microsoft.Agents.AI"
                         Condition="'$(AgentFrameworkRootProfile)' == 'Full' or '$(AgentFrameworkRootProfile)' == 'WithoutAgentsOpenAI'" />
    <TrimmerRootAssembly Include="Microsoft.Agents.AI.Abstractions"
                         Condition="'$(AgentFrameworkRootProfile)' == 'Full' or '$(AgentFrameworkRootProfile)' == 'WithoutAgentsOpenAI'" />
    <TrimmerRootAssembly Include="Microsoft.Agents.AI.OpenAI"
                         Condition="'$(AgentFrameworkRootProfile)' == 'Full'" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.AI"
                         Condition="'$(AgentFrameworkRootProfile)' != 'None'" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.AI.Abstractions"
                         Condition="'$(AgentFrameworkRootProfile)' != 'None'" />
  </ItemGroup>

  <Target Name="ValidateAgentFrameworkRootProfile"
          BeforeTargets="PrepareForILLink"
          Condition="'$(Configuration)' == 'Release' and '$(UseAgentFrameworkRuntimeDirectives)' == 'true'">
    <Error Condition="'$(AgentFrameworkRootProfile)' != 'Full' and
                      '$(AgentFrameworkRootProfile)' != 'WithoutAgentsOpenAI' and
                      '$(AgentFrameworkRootProfile)' != 'ExtensionsOnly' and
                      '$(AgentFrameworkRootProfile)' != 'None'"
           Text="Unsupported AgentFrameworkRootProfile '$(AgentFrameworkRootProfile)'. Use Full, WithoutAgentsOpenAI, ExtensionsOnly, or None." />
  </Target>
</Project>
