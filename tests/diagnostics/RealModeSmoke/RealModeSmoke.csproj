<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NuGetAudit>false</NuGetAudit>
    <CliOutput>../../../src/Madorin.AI.Runtime.Cli/bin/Debug/net10.0</CliOutput>
    <ProvidersRoot>../../../src/Providers</ProvidersRoot>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(CliOutput)/*.dll" />
    <Content Include="$(CliOutput)/runtimes/**/*" Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(CliOutput)/runtimes/win-x64/native/e_sqlite3.dll" Link="e_sqlite3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    RealModeSmoke 进程内启动 RuntimeServer。Worker 是独立框架依赖进程，须带齐输出目录。
    拷到 $(OutputPath)providers/，由 Program 设置 MADORIN_PROVIDER_DIR，避免与冒烟宿主 dll 混放。
  -->
  <Target Name="CopyProviderWorkers" AfterTargets="Build">
    <PropertyGroup>
      <_ProviderWorkersOut>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutputPath)providers'))</_ProviderWorkersOut>
      <_ProvidersRootFull>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(ProvidersRoot)'))</_ProvidersRootFull>
    </PropertyGroup>
    <!--
      多 Worker 合并到同一目录时共享 DLL 会互相覆盖。冒烟默认只暂存 DeepSeek；
      需要其他协议时先重建对应 Worker，再临时扩这份列表，并保证 WorkerHost 同源。
    -->
    <ItemGroup>
      <_ProviderWorkerProjectDir Include="$(_ProvidersRootFull)\Madorin.AI.Runtime.Providers.DeepSeek.Worker" />
      <_ProviderWorkerBin Include="@(_ProviderWorkerProjectDir->'%(Identity)\bin\$(Configuration)\$(TargetFramework)')" Condition="Exists('%(Identity)\bin\$(Configuration)\$(TargetFramework)\')" />
      <_ProviderWorkerFiles Include="%(_ProviderWorkerBin.Identity)\**\*.*" />
    </ItemGroup>
    <RemoveDir Directories="$(_ProviderWorkersOut)" Condition="Exists('$(_ProviderWorkersOut)')" />
    <MakeDir Directories="$(_ProviderWorkersOut)" Condition="'@(_ProviderWorkerFiles)' != ''" />
    <Copy SourceFiles="@(_ProviderWorkerFiles)" DestinationFolder="$(_ProviderWorkersOut)" SkipUnchangedFiles="false" Condition="'@(_ProviderWorkerFiles)' != ''" />
    <Message Importance="High" Text="Provider workers staged at $(_ProviderWorkersOut)" Condition="'@(_ProviderWorkerFiles)' != ''" />
    <Warning Text="No Provider Worker outputs found. Build Worker projects first (at least DeepSeek.Worker)." Condition="'@(_ProviderWorkerFiles)' == ''" />
  </Target>
</Project>
